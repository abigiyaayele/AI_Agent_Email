# ---- Required ----
# Any PostgreSQL 14+ database. Supabase works: use the "Session pooler" or direct connection string.
DATABASE_URL=postgres://goalflow:goalflow@localhost:5432/goalflow

# Public URL of the app (used in reminder emails and push notification links).
APP_URL=http://localhost:3002

# ---- Background jobs ----
# Shared secret for /api/cron/* endpoints (reminder dispatch). Generate with: openssl rand -hex 32
CRON_SECRET=
# Set to "true" to run the reminder dispatcher inside the Next.js server process every minute
# (good for a single long-running server; leave off on serverless and use a cron instead).
INPROCESS_SCHEDULER=false

# ---- Web Push (optional) ----
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Email reminders (optional) ----
# Provider: "resend" or "console" (logs emails to the server console). Leave blank to disable email.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=GoalFlow <reminders@example.com>

# ---- AI assistant (optional) ----
# Provider: "anthropic" or "none". With "none" (or no key) GoalFlow uses its built-in rule-based planner and summaries.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
